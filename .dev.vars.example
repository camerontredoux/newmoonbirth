# Copy to .dev.vars for `astro dev`. In production, set these with `pnpm exec wrangler secret put <NAME>`.

# Turnstile's test secret, which accepts the test site key in ContactForm.tsx. Production uses the real widget's secret.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# The test secret reports every check as coming from example.com. Production's hostnames are in wrangler.jsonc.
TURNSTILE_HOSTNAMES=example.com
# Where contact form messages go. `astro dev` only logs the email, so any address works.
CONTACT_EMAIL_TO=you@example.com

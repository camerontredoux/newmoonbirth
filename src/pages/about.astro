---
import ArchPhoto from "../components/ArchPhoto.astro";
import MoonPhase from "../components/MoonPhase.astro";
import Base from "../layouts/Base.astro";
import starleePhoto from "../assets/photos/meet-starlee.jpg";
---

<Base
	title="About Starlee"
	description="Meet Starlee Brown, the birth doula behind New Moon Birth: a yoga teacher and barista in Washougal, Washington, who supports families through pregnancy, labor, and birth."
>
	<Fragment slot="heading">Meet your <span class="script text-moon-blue">doula</span></Fragment>

	<section aria-label="About Starlee" class="px-6 pb-28 md:px-10 md:pb-40">
		<div class="mx-auto grid max-w-6xl items-center gap-16 md:grid-cols-[5fr_7fr] md:gap-20 lg:gap-28">
			<ArchPhoto
				src={starleePhoto}
				alt="Starlee smiles over her shoulder on a garden path"
				sizes="(min-width: 768px) 26rem, 90vw"
				crop="object-[50%_30%]"
				class="reveal mx-auto w-full max-w-sm"
			/>
			<div class="max-w-[36rem] space-y-6">
				<p class="reveal font-display text-[clamp(1.5rem,1.25rem+0.8vw,2rem)] leading-[1.35] text-moon-navy">
					I’m a yoga teacher, a barista, and a big fan of a good book and a warm cup of tea.
				</p>
				<p class="reveal">
					I love connecting with people and creating spaces where everyone feels welcome to show up exactly as they
					are.
				</p>
				<p class="reveal">
					As your doula, I hope to be someone you feel completely comfortable around. Someone you can laugh with, cry
					with, or just sit quietly with. I believe every person deserves to have their birth preferences respected,
					without judgment or expectations. My goal is to take some of the weight off your shoulders so you can focus
					on what matters most to you: bringing your baby into the world.
				</p>
			</div>
		</div>
	</section>

	<section aria-label="My approach" class="bg-moon-sand/35 px-6 py-28 md:px-10 md:py-40">
		<figure class="reveal mx-auto max-w-4xl text-center">
			<div aria-hidden="true" class="flex items-center justify-center gap-3 text-moon-navy">
				<MoonPhase id="approach-waxing" class="moon-waxing size-4" />
				<MoonPhase id="approach-full" class="moon-full size-5" />
				<MoonPhase id="approach-waning" class="moon-waning size-4" />
			</div>
			<blockquote class="mt-10 font-display text-[clamp(1.75rem,1.25rem+1.7vw,2.75rem)] leading-[1.3] text-balance text-moon-navy">
				<p>
					“I’m not there to make decisions for you or tell you how your birth should look. I’m there to help you feel
					informed, cared for, and comfortable making the decisions that feel right for you.”
				</p>
			</blockquote>
			<figcaption class="mt-10 font-script text-5xl leading-none text-moon-blue">Starlee</figcaption>
		</figure>
	</section>
</Base>

---
import { Picture } from "astro:assets";
import ArchPhoto from "../components/ArchPhoto.astro";
import MoonPhase from "../components/MoonPhase.astro";
import ServiceAreaMap from "../components/ServiceAreaMap.astro";
import Base from "../layouts/Base.astro";
import heroPhoto from "../assets/photos/hero-linen.jpg";
import introPhoto from "../assets/photos/meet-starlee.jpg";
import teaPhoto from "../assets/photos/tea-blanket.jpg";
import bellySupportPhoto from "../assets/photos/belly-support.jpg";
import babyHandPhoto from "../assets/photos/baby-hand.jpg";
import newbornChestPhoto from "../assets/photos/newborn-chest.jpg";

const formats = ["avif", "webp"];

// "What a doula does": the three parts of the tagline, each in words from Starlee's brochure.
const values = [
	{
		title: "Calm hands",
		text: "Help finding comfortable positions, comfort measures, and hands-on support throughout your labor and birth.",
	},
	{
		title: "Clear head",
		text: "Answers to your questions and help navigating your options, so you feel informed making the decisions that feel right for you.",
	},
	{
		title: "Full heart",
		text: "Encouragement for you and your birth partner, and someone who’s there just for you.",
	},
];

// "Support through every phase". Each step has its own moon phase, and the large moon beside the list matches it.
// On phones the photos are cropped wider, and `crop` keeps the faces and hands in the frame.
const phases = [
	{
		moon: "moon-new",
		phase: "New moon",
		title: "A first conversation",
		photo: teaPhoto,
		alt: "A mustard mug of tea on a saucer, set on a chunky cream knit blanket",
		crop: "object-[50%_35%]",
		text: "It starts with a free consultation, a chance to ask your questions and see if we’re a good fit.",
	},
	{
		moon: "moon-waxing",
		phase: "Waxing moon",
		title: "Pregnancy",
		photo: bellySupportPhoto,
		alt: "A woman in a linen dress rests her hands on a pregnant woman’s belly in a sunny room",
		crop: "object-[50%_45%]",
		text: "Two prenatal visits to get to know each other, talk through your hopes and preferences for birth, and prepare for labor. In between, I’m a text or call away.",
	},
	{
		moon: "moon-full",
		phase: "Full moon",
		title: "Birth",
		photo: babyHandPhoto,
		alt: "A newborn’s hand wraps around a parent’s finger",
		crop: "object-center",
		text: "I’m on call for the two weeks before your due date. When labor begins, I join you and stay through your labor and birth, with hands-on comfort, encouragement, and support for your birth partner.",
	},
	{
		moon: "moon-waning",
		phase: "Waning moon",
		title: "Postpartum",
		photo: newbornChestPhoto,
		alt: "A newborn sleeps on a parent’s shoulder",
		crop: "object-center",
		text: "Two postpartum visits to check in, talk about your birth experience, see how you’re doing, and support you as you settle into life with your new baby.",
	},
];

// PLACEHOLDER QUOTES. They show how the section looks, and only in `astro dev`: a build leaves out every quote marked
// `placeholder`, and the whole section when none are left. Replace them with real words from Starlee's clients,
// used with their permission.
const allWords = [
	{
		quote: "Starlee made our birth feel calm and completely ours. She knew when to talk, when to hold my hand, and when to just be quiet with me.",
		name: "Client name",
		place: "Camas, Washington",
		placeholder: true,
	},
	{
		quote: "My partner never felt like a spare part. Starlee showed him how to help, and then let him.",
		name: "Client name",
		place: "Portland, Oregon",
		placeholder: true,
	},
	{
		quote: "In those first weeks at home, she checked in on me, not just the baby. I didn’t know how much I needed that.",
		name: "Client name",
		place: "Vancouver, Washington",
		placeholder: true,
	},
];
const words = allWords.filter((word) => import.meta.env.DEV || !word.placeholder);
const [featuredWord, ...moreWords] = words;
---

<Base
	title="Birth doula in Portland and southwest Washington"
	description="New Moon Birth: birth doula support from Starlee Brown in Portland and Gresham, OR, and Vancouver, Camas, and Washougal, WA. Book a free consultation."
>
	<section
		slot="hero"
		aria-labelledby="hero-title"
		class="relative isolate flex min-h-[max(100svh,40rem)] flex-col overflow-hidden bg-moon-ink text-moon-cream"
	>
		<Picture
			src={heroPhoto}
			alt="A pregnant woman in a white linen dress rests her hands on her belly"
			widths={[640, 960, 1280, 1920, 2400]}
			sizes="100vw"
			formats={formats}
			loading="eager"
			fetchpriority="high"
			class="absolute inset-0 -z-20 size-full object-cover object-[50%_40%] motion-safe:animate-settle"
		/>
		<div aria-hidden="true" class="absolute inset-0 -z-10 bg-moon-navy/35 mix-blend-multiply"></div>
		<div
			aria-hidden="true"
			class="absolute inset-0 -z-10 bg-linear-to-b from-moon-ink/50 via-moon-ink/30 to-moon-ink/70"
		>
		</div>

		<div class="flex flex-1 flex-col items-center justify-center px-6 pt-32 pb-12 text-center">
			<h1
				id="hero-title"
				class="text-[clamp(2.75rem,1.25rem+4.6vw,7.5rem)] leading-[1.1] tracking-[-0.01em] text-moon-cream"
			>
				<span class="motion-safe:animate-rise md:block motion-safe:[animation-delay:250ms]">Like the new moon,</span>{" "}
				<span class="motion-safe:animate-rise md:block motion-safe:[animation-delay:500ms]">
					every birth is a <span class="script">beginning</span>
				</span>
			</h1>
			<div class="mt-12 flex flex-col items-center gap-8 motion-safe:animate-rise motion-safe:[animation-delay:850ms] md:mt-16">
				<svg aria-hidden="true" viewBox="0 0 180 12" fill="none" class="h-3.5 w-44 overflow-visible text-moon-cream/80">
					<path
						d="M1 6 C 11 0.5, 19 0.5, 30 6 S 49 11.5, 60 6 S 79 0.5, 90 6 S 109 11.5, 120 6 S 139 0.5, 150 6 S 169 11.5, 179 6"
						stroke="currentColor"
						stroke-width="1.25"
						stroke-linecap="round"
						vector-effect="non-scaling-stroke"
						pathLength="1"
						class="motion-safe:animate-draw-out"
					></path>
				</svg>
				<p class="caps">Birth doula · Washougal, Washington</p>
				<div class="flex flex-wrap justify-center gap-4">
					<a href="/contact/" class="button-light">Book a free consultation</a>
					<a href="/what-is-a-doula/" class="button-outline text-moon-cream">What a doula does</a>
				</div>
			</div>
		</div>
		<p class="caps hidden px-6 pb-8 text-center sm:block text-[0.65rem] text-moon-cream/85">
			Portland · Gresham · Vancouver · Camas · Washougal
		</p>
	</section>

	<section aria-labelledby="intro-title" class="px-6 py-24 md:px-10 md:py-40">
		<div class="mx-auto grid max-w-6xl items-center gap-16 md:grid-cols-[5fr_7fr] md:gap-20 lg:gap-28">
			<ArchPhoto
				src={introPhoto}
				alt="Starlee smiles over her shoulder on a garden path"
				sizes="(min-width: 768px) 26rem, 90vw"
				crop="object-[50%_30%]"
				class="reveal mx-auto w-full max-w-sm"
			/>
			<div>
				<h2 id="intro-title" class="reveal text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
					<span class="script text-moon-blue">Hello,</span> I’m Starlee
				</h2>
				<div class="mt-8 max-w-[36rem] space-y-6">
					<p class="reveal font-display text-[clamp(1.5rem,1.25rem+0.8vw,2rem)] leading-[1.35] text-moon-navy">
						I’m a yoga teacher, a barista, and a big fan of a good book and a warm cup of tea.
					</p>
					<p class="reveal">
						I love connecting with people and creating spaces where everyone feels welcome to show up exactly as they
						are.
					</p>
					<p class="reveal">
						As your doula, I hope to be someone you feel completely comfortable around. Someone you can laugh with, cry
						with, or just sit quietly with. I believe every person deserves to have their birth preferences respected,
						without judgment or expectations. My goal is to take some of the weight off your shoulders so you can focus
						on what matters most to you: bringing your baby into the world.
					</p>
				</div>
				<a href="/about/" class="reveal button-outline mt-10 text-moon-navy">More about Starlee</a>
			</div>
		</div>
	</section>

	<section aria-labelledby="doula-title" class="px-6 pb-28 md:px-10 md:pb-40">
		<div class="mx-auto max-w-6xl border-t border-moon-gold/60 pt-24 md:pt-32">
			<div class="grid gap-8 md:grid-cols-2 md:gap-20">
				<div class="reveal">
					<p class="caps">What a doula does</p>
					<h2 id="doula-title" class="mt-6 text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
						Someone in your <span class="script text-moon-blue">corner</span>
					</h2>
				</div>
				<div class="reveal [--reveal-step:1] md:pt-16">
					<p class="max-w-md">
						A birth doula provides continuous support throughout pregnancy, labor, and birth. Think of us as an extra
						set of hands, a familiar face, and someone who’s there just for you.
					</p>
					<a href="/what-is-a-doula/" class="button-outline mt-10 text-moon-navy">More about doulas</a>
				</div>
			</div>
			<ul class="mt-20 grid gap-12 md:mt-28 md:grid-cols-3 md:gap-12 lg:gap-16">
				{
					values.map((value, i) => (
						<li style={`--reveal-step: ${i}`} class="reveal border-t border-moon-navy/20 pt-8">
							<h3 class="text-[clamp(1.75rem,1.5rem+0.8vw,2.25rem)] leading-[1.15]">{value.title}</h3>
							<p class="mt-4 max-w-xs">{value.text}</p>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section aria-labelledby="area-title" class="px-6 pb-28 md:px-10 md:pb-40">
		<div
			class="mx-auto grid max-w-6xl items-center gap-10 border-t border-moon-gold/60 pt-24 md:pt-32 lg:grid-cols-[2fr_3fr] lg:gap-16"
		>
			<div class="reveal">
				<p class="caps">Service area</p>
				<h2 id="area-title" class="mt-6 text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
					Close to <span class="script text-moon-blue">home</span>
				</h2>
				<p class="mt-6 max-w-sm">
					Based in Washougal, I support families across north Oregon and southwest Washington.
				</p>
			</div>
			<ServiceAreaMap class="-mx-6 md:-mx-10 lg:mx-0" />
		</div>
	</section>

	<section aria-labelledby="phases-title" class="phases bg-moon-sand/35 px-6 py-28 md:px-10 md:py-40">
		<div class="mx-auto max-w-6xl">
			<div class="reveal grid gap-6 md:grid-cols-2 md:items-end md:gap-20">
				<div>
					<p class="caps">How we’ll work together</p>
					<h2 id="phases-title" class="mt-6 text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
						Support through every <span class="script text-moon-blue">phase</span>
					</h2>
				</div>
				<p class="max-w-md">
					My birth support package covers every phase, from our first conversation to the weeks after your baby arrives.
				</p>
			</div>
			<div class="mt-20 md:mt-28 lg:grid lg:grid-cols-[5fr_7fr] lg:gap-24">
				<div aria-hidden="true" class="hidden lg:block">
					<div class="sticky top-[max(7rem,calc(50svh-11rem))]">
						<MoonPhase id="phases-moon" class="phases-moon mx-auto w-full max-w-88 text-moon-navy" />
					</div>
				</div>
				<ol class="phases-list mx-auto max-w-3xl space-y-20 md:space-y-28 lg:max-w-none">
					{
						phases.map((step, i) => (
							<li class="reveal grid items-center gap-8 sm:grid-cols-[minmax(0,1fr)_13rem] md:gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
								<div>
									<div class="flex items-center gap-4">
										<MoonPhase id={`phase-${i}`} class={`${step.moon} size-9 shrink-0 text-moon-navy`} />
										<p class="caps">{step.phase}</p>
									</div>
									<h3 class="mt-6 text-[clamp(2rem,1.6rem+1.2vw,2.75rem)] leading-[1.15]">{step.title}</h3>
									<p class="mt-4 max-w-sm">{step.text}</p>
								</div>
								<Picture
									src={step.photo}
									alt={step.alt}
									widths={[400, 640, 840]}
									sizes="(min-width: 640px) 14rem, 100vw"
									formats={formats}
									class:list={[step.crop, "aspect-4/3 w-full object-cover sm:aspect-4/5"]}
								/>
							</li>
						))
					}
				</ol>
			</div>
			<p class="reveal mt-24 text-center md:mt-32">
				<a href="/services/" class="button-solid">See the birth support package</a>
			</p>
		</div>
	</section>

	{
		featuredWord && (
			<section aria-labelledby="words-title" class="px-6 py-28 md:px-10 md:py-40">
				<div class="mx-auto max-w-5xl">
					<div class="reveal flex flex-col items-center">
						<div aria-hidden="true" class="flex items-center gap-3 text-moon-navy">
							<MoonPhase id="words-waxing" class="moon-waxing size-4" />
							<MoonPhase id="words-full" class="moon-full size-5" />
							<MoonPhase id="words-waning" class="moon-waning size-4" />
						</div>
						<h2 id="words-title" class="caps mt-6 text-moon-navy">
							Kind words
						</h2>
					</div>
					<figure class="reveal mx-auto mt-12 max-w-4xl text-center">
						<blockquote class="font-display text-[clamp(1.75rem,1.25rem+1.7vw,2.75rem)] leading-[1.3] text-balance text-moon-navy">
							<p>“{featuredWord.quote}”</p>
						</blockquote>
						<figcaption class="mt-10">
							<span class="block font-script text-5xl leading-none text-moon-blue">{featuredWord.name}</span>
							<span class="caps mt-3 block">{featuredWord.place}</span>
						</figcaption>
					</figure>
					{moreWords.length > 0 && (
						<div class="mt-24 grid gap-16 border-t border-moon-navy/15 pt-16 md:grid-cols-2 md:gap-20">
							{moreWords.map((word, i) => (
								<figure style={`--reveal-step: ${i}`} class="reveal">
									<blockquote class="font-display text-[clamp(1.375rem,1.25rem+0.5vw,1.75rem)] leading-[1.4] text-moon-navy">
										<p>“{word.quote}”</p>
									</blockquote>
									<figcaption class="mt-6 flex items-baseline gap-4">
										<span class="font-script text-4xl leading-none text-moon-blue">{word.name}</span>
										<span class="caps">{word.place}</span>
									</figcaption>
								</figure>
							))}
						</div>
					)}
				</div>
			</section>
		)
	}
</Base>

---
import { Picture } from "astro:assets";
import ArchPhoto from "../components/ArchPhoto.astro";
import MoonPhase from "../components/MoonPhase.astro";
import Base from "../layouts/Base.astro";
import handsPhoto from "../assets/photos/hands-blanket.jpg";
import teaPhoto from "../assets/photos/tea-blanket.jpg";
import bellySupportPhoto from "../assets/photos/belly-support.jpg";
import babyHandPhoto from "../assets/photos/baby-hand.jpg";
import newbornChestPhoto from "../assets/photos/newborn-chest.jpg";

const formats = ["avif", "webp"];

// The figures and their wording are from Starlee's brochure, which cites this review.
const source = {
	title: "Continuous support for women during childbirth",
	citation: "Bohren and others, Cochrane Database of Systematic Reviews, 2017",
	url: "https://doi.org/10.1002/14651858.CD003766.pub6",
};
const findings = [
	{ figure: "25%", text: "Lower risk of cesarean birth." },
	{ figure: "31%", text: "Lower likelihood of having negative feelings about your birth experience." },
	{ figure: "41", unit: "minutes", text: "Shorter average labor duration." },
	{ figure: "8%", text: "Greater likelihood of spontaneous vaginal birth." },
];

// "Support through every phase". Each step has its own moon phase, and the large moon beside the list matches it.
// On phones the photos are cropped wider, and `crop` keeps the faces and hands in the frame.
const phases = [
	{
		moon: "moon-new",
		phase: "New moon",
		title: "A first conversation",
		photo: teaPhoto,
		alt: "A mustard mug of tea on a saucer, set on a chunky cream knit blanket",
		crop: "object-[50%_35%]",
		text: "It starts with a free consultation, a chance to ask your questions and see if we’re a good fit.",
	},
	{
		moon: "moon-waxing",
		phase: "Waxing moon",
		title: "Pregnancy",
		photo: bellySupportPhoto,
		alt: "A woman in a linen dress rests her hands on a pregnant woman’s belly in a sunny room",
		crop: "object-[50%_45%]",
		text: "Two prenatal visits to get to know each other, talk through your hopes and preferences for birth, and prepare for labor. In between, I’m a text or call away.",
	},
	{
		moon: "moon-full",
		phase: "Full moon",
		title: "Birth",
		photo: babyHandPhoto,
		alt: "A newborn’s hand wraps around a parent’s finger",
		crop: "object-center",
		text: "I’m on call for the two weeks before your due date. When labor begins, I join you and stay through your labor and birth, with hands-on comfort, encouragement, and support for your birth partner.",
	},
	{
		moon: "moon-waning",
		phase: "Waning moon",
		title: "Postpartum",
		photo: newbornChestPhoto,
		alt: "A newborn sleeps on a parent’s shoulder",
		crop: "object-center",
		text: "Two postpartum visits to check in, talk about your birth experience, see how you’re doing, and support you as you settle into life with your new baby.",
	},
];
---

<Base
	title="What is a doula"
	description="What a birth doula does, and the difference continuous support can make in labor and birth. Birth doula support in Portland and southwest Washington."
>
	<Fragment slot="heading">What is a birth <span class="script text-moon-blue">doula</span>?</Fragment>

	<section aria-label="What a birth doula does" class="px-6 pb-28 md:px-10 md:pb-40">
		<div class="mx-auto grid max-w-6xl items-start gap-16 md:grid-cols-[7fr_5fr] md:gap-20 lg:gap-28">
			<div class="max-w-[36rem] space-y-6">
				<p class="reveal font-display text-[clamp(1.5rem,1.25rem+0.8vw,2rem)] leading-[1.35] text-moon-navy">
					A birth doula is someone who provides continuous support throughout pregnancy, labor, and birth. Think of
					us as an extra set of hands, a familiar face, and someone who’s there just for you.
				</p>
				<p class="reveal">
					From helping you find comfortable positions and offering comfort measures during labor, to answering
					questions and helping you navigate your options, my role is to support you in whatever ways you need.
				</p>
				<p class="reveal">
					I’m not there to make decisions for you or tell you how your birth should look. I’m there to help you feel
					informed, cared for, and comfortable making the decisions that feel right for you.
				</p>
			</div>
			<ArchPhoto
				src={handsPhoto}
				alt="A baby in a fluffy white suit holds a parent’s finger"
				sizes="(min-width: 768px) 26rem, 90vw"
				crop="object-[40%_50%]"
				class="reveal mx-auto w-full max-w-sm"
			/>
		</div>
	</section>

	<section aria-labelledby="difference-title" class="bg-moon-sand/35 px-6 py-28 md:px-10 md:py-40">
		<div class="mx-auto max-w-6xl">
			<div class="reveal grid gap-6 md:grid-cols-2 md:items-end md:gap-20">
				<h2 id="difference-title" class="text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
					The difference a doula can <span class="script text-moon-blue">make</span>
				</h2>
				<p class="max-w-md">
					Whether it’s your first baby or your fifth, having someone dedicated to your comfort, needs, and experience
					can make a meaningful difference. Research continues to show the benefits of continuous support throughout
					labor and birth.
				</p>
			</div>
			<dl class="mt-20 grid gap-12 sm:grid-cols-2 md:mt-28 lg:grid-cols-4 lg:gap-10">
				{
					findings.map((finding, i) => (
						<div style={`--reveal-step: ${i}`} class="reveal flex flex-col border-t border-moon-navy/20 pt-8">
							<dt class="order-last mt-4 max-w-60">{finding.text}</dt>
							<dd class="font-display text-[clamp(3.5rem,2.75rem+2.4vw,5rem)] leading-none text-moon-navy">
								{finding.figure}
								{finding.unit && <span class="caps ml-1 align-middle text-moon-blue">{finding.unit}</span>}
							</dd>
						</div>
					))
				}
			</dl>
			<p class="reveal mt-16 max-w-2xl text-sm text-moon-ink/75">
				Compared with no continuous support. Source: <a href={source.url} class="underline underline-offset-4 decoration-moon-gold hover:text-moon-navy">{source.title}</a>, {source.citation}.
			</p>
		</div>
	</section>

	<section aria-labelledby="phases-title" class="phases px-6 py-28 md:px-10 md:py-40">
		<div class="mx-auto max-w-6xl">
			<div class="reveal grid gap-6 md:grid-cols-2 md:items-end md:gap-20">
				<div>
					<p class="caps">How we’ll work together</p>
					<h2 id="phases-title" class="mt-6 text-[clamp(2.5rem,1.75rem+2.4vw,4rem)] leading-[1.1]">
						Support through every <span class="script text-moon-blue">phase</span>
					</h2>
				</div>
				<p class="max-w-md">
					My birth support package covers every phase, from our first conversation to the weeks after your baby arrives.
				</p>
			</div>
			<div class="mt-20 md:mt-28 lg:grid lg:grid-cols-[5fr_7fr] lg:gap-24">
				<div aria-hidden="true" class="hidden lg:block">
					<div class="sticky top-[max(7rem,calc(50svh-11rem))]">
						<MoonPhase id="phases-moon" class="phases-moon mx-auto w-full max-w-88 text-moon-navy" />
					</div>
				</div>
				<ol class="phases-list mx-auto max-w-3xl space-y-20 md:space-y-28 lg:max-w-none">
					{
						phases.map((step, i) => (
							<li class="reveal grid items-center gap-8 sm:grid-cols-[minmax(0,1fr)_13rem] md:gap-12 lg:grid-cols-[minmax(0,1fr)_14rem]">
								<div>
									<div class="flex items-center gap-4">
										<MoonPhase id={`phase-${i}`} class={`${step.moon} size-9 shrink-0 text-moon-navy`} />
										<p class="caps">{step.phase}</p>
									</div>
									<h3 class="mt-6 text-[clamp(2rem,1.6rem+1.2vw,2.75rem)] leading-[1.15]">{step.title}</h3>
									<p class="mt-4 max-w-sm">{step.text}</p>
								</div>
								<Picture
									src={step.photo}
									alt={step.alt}
									widths={[400, 640, 840]}
									sizes="(min-width: 640px) 14rem, 100vw"
									formats={formats}
									class:list={[step.crop, "aspect-4/3 w-full object-cover sm:aspect-4/5"]}
								/>
							</li>
						))
					}
				</ol>
			</div>
			<p class="reveal mt-24 text-center md:mt-32">
				<a href="/services/" class="button-solid">See the birth support package</a>
			</p>
		</div>
	</section>
</Base>

---
import "../styles/global.css";

interface Props {
	title: string;
}

const { title } = Astro.props;

const nav = [
	{ href: "/", label: "Home" },
	{ href: "/what-is-a-doula/", label: "What is a doula" },
	{ href: "/services/", label: "Services" },
	{ href: "/about/", label: "About" },
	{ href: "/gallery/", label: "Gallery" },
	{ href: "/contact/", label: "Contact & booking" },
	{ href: "/billing/", label: "Billing help" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width" />
		<title>{title} | New Moon Birth</title>
		<link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
		<link rel="sitemap" href="/sitemap-index.xml" />
	</head>
	<body>
		<header>
			<a href="/"><img src="/logo-wide.png" alt="New Moon Birth" width="210" height="120" /></a>
			<nav>
				<ul>
					{nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
				</ul>
			</nav>
		</header>
		<main>
			<h1>{title}</h1>
			<slot />
		</main>
		<footer>
			<p>New Moon Birth · Starlee Brown, doula · Washougal, WA</p>
			<p>Serving north Oregon and southwest Washington.</p>
		</footer>
	</body>
</html>

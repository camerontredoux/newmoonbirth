---
import { Font } from "astro:assets";
import Logo from "../components/Logo.astro";
import MoonPhase from "../components/MoonPhase.astro";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Keeps the page out of search results, for example the 404 page. */
	noindex?: boolean;
	/** A small label above the h1, on a page without a hero. */
	eyebrow?: string;
}

const { title, description, noindex = false, eyebrow } = Astro.props;

const siteName = "New Moon Birth";
const fullTitle = `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = {
	url: new URL("/og-image.png", Astro.site).href,
	width: 1200,
	height: 630,
	alt: "New Moon Birth logo: a watercolor crescent moon beside the name",
};

// The towns Starlee serves, for the footer and for Google.
const towns = [
	{ name: "Portland", state: "OR" },
	{ name: "Gresham", state: "OR" },
	{ name: "Vancouver", state: "WA" },
	{ name: "Camas", state: "WA" },
	{ name: "Washougal", state: "WA" },
];

// Tells Google the site name, and that this is a local business with a phone number and service area.
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${Astro.site}#website`,
			url: Astro.site?.href,
			name: siteName,
			publisher: { "@id": `${Astro.site}#business` },
			inLanguage: "en-US",
		},
		{
			"@type": "LocalBusiness",
			"@id": `${Astro.site}#business`,
			name: siteName,
			description: "Birth doula support from Starlee Brown in north Oregon and southwest Washington.",
			url: Astro.site?.href,
			logo: new URL("/logo.png", Astro.site).href,
			image: shareImage.url,
			telephone: "+1-281-995-4078",
			email: "starlee@newmoonbirth.com",
			address: {
				"@type": "PostalAddress",
				addressLocality: "Washougal",
				addressRegion: "WA",
				addressCountry: "US",
			},
			areaServed: towns.map((town) => ({ "@type": "City", name: `${town.name}, ${town.state}` })),
			founder: { "@id": `${Astro.site}#starlee` },
		},
		{
			"@type": "Person",
			"@id": `${Astro.site}#starlee`,
			name: "Starlee Brown",
			jobTitle: "Birth doula",
			worksFor: { "@id": `${Astro.site}#business` },
			url: Astro.site?.href,
		},
	],
};

// A page that fills the `hero` slot supplies its own h1. It gets a transparent header over the hero, and a white one after it.
// Any other page gets a page heading: the `heading` slot if it fills it, or else the title. Each page lays out its own
// sections below the heading.
const hasHero = Astro.slots.has("hero");

const nav = [
	{ href: "/", label: "Home" },
	{ href: "/what-is-a-doula/", label: "What is a doula" },
	{ href: "/services/", label: "Services" },
	{ href: "/contact/", label: "Contact & booking" },
];

const current = (href: string) => (Astro.url.pathname === href ? "page" : undefined);

// The footer's invitation leads to the contact page, so the contact page leaves it out.
const invite = Astro.url.pathname !== "/contact/";
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Starlee Brown" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={shareImage.url} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(shareImage.width)} />
		<meta property="og:image:height" content={String(shareImage.height)} />
		<meta property="og:image:alt" content={shareImage.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage.url} />
		<meta name="twitter:image:alt" content={shareImage.alt} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<Font cssVariable="--font-gilda" preload />
		<Font cssVariable="--font-corinthia" preload />
		<Font cssVariable="--font-jost" preload={[{ weight: 300 }]} />
	</head>
	<body>
		{hasHero && <SiteHeader nav={nav} variant="overlay" />}
		<SiteHeader nav={nav} variant="solid" floating={hasHero} />

		<div
			id="site-menu"
			popover
			class="inset-0 m-0 h-dvh max-h-none w-full max-w-none bg-moon-cream p-0 text-moon-navy opacity-0 transition-[opacity,display,overlay] transition-discrete duration-500 ease-out-expo [&:popover-open]:opacity-100 starting:[&:popover-open]:opacity-0"
		>
			<div class="flex items-center justify-between px-6 py-6 md:px-10 md:py-8">
				<span aria-hidden="true"><Logo class="[--wordmark-width:10rem] md:[--wordmark-width:13rem]" /></span>
				<button type="button" popovertarget="site-menu" popovertargetaction="hide" class="caps -m-3 cursor-pointer p-3">
					Close
				</button>
			</div>
			<nav aria-label="Menu" class="px-6 pt-8 md:px-10">
				<ul class="space-y-2">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={current(item.href)}
									class="nav-link font-display text-4xl leading-tight text-moon-navy [--nav-link-offset:-0.05em] md:text-5xl"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		{
			hasHero ? (
				<main>
					{/* The first 24px of the page. The transparent header fades out once this leaves the screen. */}
					<div data-page-top aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-6"></div>
					<slot name="hero" />
					{/* The white header fades in when this marker, 120px above the hero's bottom edge, leaves the screen. */}
					<div aria-hidden="true" class="relative">
						<div data-hero-end class="absolute inset-x-0 -top-30 h-px"></div>
					</div>
					<slot />
				</main>
			) : (
				<main>
					<div class="px-6 pt-16 pb-14 md:px-10 md:pt-24 md:pb-20">
						<div class="mx-auto max-w-6xl">
							{eyebrow && <p class="caps mb-6">{eyebrow}</p>}
							<h1 class="max-w-4xl text-[clamp(3rem,2rem+3.6vw,5.5rem)] leading-[1.05] tracking-[-0.01em]">
								<slot name="heading">{title}</slot>
							</h1>
						</div>
					</div>
					<slot />
				</main>
			)
		}

		<footer class="overflow-hidden bg-moon-ink text-moon-cream/80">
			<div class="mx-auto max-w-7xl px-6 md:px-10">
				{
					invite && (
						<div class="grid items-center gap-12 border-b border-moon-cream/15 py-24 md:grid-cols-[1.25fr_1fr] md:gap-20 md:py-32">
							<div class="reveal">
								<p class="caps text-moon-mist">The first conversation is free</p>
								<h2 class="mt-6 text-[clamp(2.75rem,1.75rem+3.2vw,5rem)] leading-[1.1] text-moon-cream">
									Let’s <span class="script">connect</span>
								</h2>
								<p class="mt-6 max-w-md">
									Tell me about your due date, your plans, and your questions, and we’ll see if we’re a good fit.
								</p>
								<a href="/contact/" class="button-light mt-10">
									Book a free consultation
								</a>
							</div>
							<div data-light class="footer-moon order-first mx-auto w-28 md:order-none md:w-full md:max-w-sm">
								<MoonPhase id="footer-moon" class="w-full text-moon-cream" />
							</div>
						</div>
					)
				}
				<div class="grid gap-12 py-16 sm:grid-cols-2 md:py-20 lg:grid-cols-[1.4fr_1fr_1fr_1fr] lg:gap-10">
					<p class="max-w-xs font-display text-2xl leading-snug text-moon-cream">
						Birth doula support in north Oregon and southwest Washington.
					</p>
					<nav aria-labelledby="footer-explore">
						<h2 id="footer-explore" class="caps text-moon-mist">Explore</h2>
						<ul class="mt-6 space-y-3">
							{
								nav.slice(1).map((item) => (
									<li>
										<a href={item.href} class="nav-link text-moon-cream [--nav-link-offset:-0.15rem]">
											{item.label}
										</a>
									</li>
								))
							}
						</ul>
					</nav>
					<div>
						<h2 class="caps text-moon-mist">Serving</h2>
						<ul class="mt-6 space-y-3">
							{
								towns.map((town) => (
									<li>
										{town.name}, {town.state}
									</li>
								))
							}
						</ul>
					</div>
					<div>
						<h2 class="caps text-moon-mist">Contact</h2>
						<ul class="mt-6 space-y-3">
							<li>Starlee Brown, birth doula</li>
							<li>
								<a href="tel:+12819954078" class="nav-link text-moon-cream [--nav-link-offset:-0.15rem]">
									281-995-4078
								</a>
							</li>
							<li>
								<a href="mailto:starlee@newmoonbirth.com" class="nav-link text-moon-cream [--nav-link-offset:-0.15rem]">
									starlee@newmoonbirth.com
								</a>
							</li>
							<li>Washougal, WA</li>
						</ul>
					</div>
				</div>
				<span aria-hidden="true" data-light class="wordmark relative block w-full text-moon-cream"></span>
				<div class="caps flex flex-wrap justify-between gap-x-8 gap-y-3 pt-8 pb-10 text-[0.65rem] text-moon-cream/70">
					<p>© {new Date().getFullYear()} New Moon Birth</p>
					<p>Washougal, Washington</p>
				</div>
			</div>
		</footer>

		<script>
			// Fades the transparent header out once the page scrolls, and shows the floating white header once the
			// hero is scrolled away. See SiteHeader.astro.
			const overlay = document.querySelector("[data-overlay-header]");
			const pageTop = document.querySelector("[data-page-top]");
			if (overlay && pageTop) {
				overlay.toggleAttribute("data-pinned", true);
				new IntersectionObserver(([entry]) => {
					overlay.toggleAttribute("data-away", !entry.isIntersecting);
				}).observe(pageTop);
				// The faded header stays focusable. When keyboard focus lands in it, go back to the top so it fades in.
				overlay.addEventListener("focusin", () => {
					if (!overlay.hasAttribute("data-away")) return;
					const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
					scrollTo({ top: 0, behavior: reduceMotion ? "instant" : "smooth" });
				});
			}

			const floating = document.querySelector("[data-floating-header]");
			const heroEnd = document.querySelector("[data-hero-end]");
			if (floating && heroEnd) {
				new IntersectionObserver(([entry]) => {
					// Past the hero once the marker has scrolled up off the screen, not while it is still below.
					floating.toggleAttribute("data-shown", !entry.isIntersecting && entry.boundingClientRect.top < 0);
				}).observe(heroEnd);
			}

			// Moonlight, for a mouse: gives each element marked `data-light`, and each button, the cursor's position over it
			// as `--light-x` and `--light-y`, from 0 at its left or top edge to 1 at its right or bottom edge. CSS draws the
			// light. See "Moonlight" in global.css. Scrolling moves the page under a still cursor, so it updates then too.
			if (matchMedia("(hover: hover) and (pointer: fine)").matches) {
				let x = 0;
				let y = 0;
				let frame = 0;
				const update = () => {
					const lit = [...document.querySelectorAll<HTMLElement>("[data-light], .button-solid, .button-light, .button-outline")];
					const boxes = lit.map((element) => element.getBoundingClientRect());
					lit.forEach((element, i) => {
						const { left, top, width, height } = boxes[i];
						if (!width || !height) return;
						element.style.setProperty("--light-x", ((x - left) / width).toFixed(3));
						element.style.setProperty("--light-y", ((y - top) / height).toFixed(3));
					});
				};
				const schedule = () => {
					cancelAnimationFrame(frame);
					frame = requestAnimationFrame(update);
				};
				addEventListener(
					"pointermove",
					(event) => {
						x = event.clientX;
						y = event.clientY;
						schedule();
					},
					{ passive: true },
				);
				addEventListener("scroll", schedule, { passive: true });
			}
		</script>
	</body>
</html>

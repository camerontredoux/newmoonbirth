---
import { Font, Image } from "astro:assets";
import moon from "../assets/moon-mark.png";
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
	title: string;
	description: string;
	/** Keeps the page out of search results, for example the 404 page. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

const siteName = "New Moon Birth";
const fullTitle = `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const shareImage = {
	url: new URL("/og-image.png", Astro.site).href,
	width: 1200,
	height: 630,
	alt: "New Moon Birth logo: a watercolor crescent moon beside the name",
};

// Tells Google the site name, and that this is a local business with a phone number and service area.
const structuredData = {
	"@context": "https://schema.org",
	"@graph": [
		{
			"@type": "WebSite",
			"@id": `${Astro.site}#website`,
			url: Astro.site?.href,
			name: siteName,
			publisher: { "@id": `${Astro.site}#business` },
			inLanguage: "en-US",
		},
		{
			"@type": "LocalBusiness",
			"@id": `${Astro.site}#business`,
			name: siteName,
			description: "Birth doula support from Starlee Brown in north Oregon and southwest Washington.",
			url: Astro.site?.href,
			logo: new URL("/logo.png", Astro.site).href,
			image: shareImage.url,
			telephone: "+1-281-995-4078",
			email: "starlee@newmoonbirth.com",
			address: {
				"@type": "PostalAddress",
				addressLocality: "Washougal",
				addressRegion: "WA",
				addressCountry: "US",
			},
			areaServed: [
				"Portland, OR",
				"Gresham, OR",
				"Vancouver, WA",
				"Camas, WA",
				"Washougal, WA",
			].map((name) => ({ "@type": "City", name })),
			founder: { "@id": `${Astro.site}#starlee` },
		},
		{
			"@type": "Person",
			"@id": `${Astro.site}#starlee`,
			name: "Starlee Brown",
			jobTitle: "Birth doula",
			worksFor: { "@id": `${Astro.site}#business` },
			url: new URL("/about/", Astro.site).href,
		},
	],
};

// A page that fills the `hero` slot supplies its own h1. It gets a transparent header over the hero, and a white one after it.
const hasHero = Astro.slots.has("hero");

const nav = [
	{ href: "/", label: "Home" },
	{ href: "/what-is-a-doula/", label: "What is a doula" },
	{ href: "/services/", label: "Services" },
	{ href: "/about/", label: "About" },
	{ href: "/contact/", label: "Contact & booking" },
	{ href: "/billing/", label: "Billing help" },
];

const current = (href: string) => (Astro.url.pathname === href ? "page" : undefined);
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<!-- Google Tag Manager -->
		<script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-M4ZZJLF8"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag("js", new Date());
		</script>
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon-32.png" sizes="32x32" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="manifest" href="/site.webmanifest" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content="Starlee Brown" />
		<meta name="robots" content={noindex ? "noindex, follow" : "index, follow, max-image-preview:large"} />
		{!noindex && <link rel="canonical" href={canonical} />}
		<link rel="sitemap" href="/sitemap-index.xml" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={siteName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		{!noindex && <meta property="og:url" content={canonical} />}
		<meta property="og:image" content={shareImage.url} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content={String(shareImage.width)} />
		<meta property="og:image:height" content={String(shareImage.height)} />
		<meta property="og:image:alt" content={shareImage.alt} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={shareImage.url} />
		<meta name="twitter:image:alt" content={shareImage.alt} />

		<script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		<Font cssVariable="--font-gilda" preload />
		<Font cssVariable="--font-corinthia" preload />
		<Font cssVariable="--font-jost" preload={[{ weight: 300 }]} />
	</head>
	<body>
		{hasHero && <SiteHeader nav={nav} variant="overlay" />}
		<SiteHeader nav={nav} variant="solid" floating={hasHero} />

		<div
			id="site-menu"
			popover
			class="inset-0 m-0 h-dvh max-h-none w-full max-w-none bg-moon-cream p-0 text-moon-navy opacity-0 transition-[opacity,display,overlay] transition-discrete duration-500 ease-out-expo [&:popover-open]:opacity-100 starting:[&:popover-open]:opacity-0"
		>
			<div class="flex items-center justify-between px-6 py-6 md:px-10 md:py-8">
				<span class="wordmark block w-40 md:w-52" aria-hidden="true"></span>
				<button type="button" popovertarget="site-menu" popovertargetaction="hide" class="caps -m-3 cursor-pointer p-3">
					Close
				</button>
			</div>
			<nav aria-label="Menu" class="px-6 pt-8 md:px-10">
				<ul class="space-y-2">
					{
						nav.map((item) => (
							<li>
								<a
									href={item.href}
									aria-current={current(item.href)}
									class="nav-link font-display text-4xl leading-tight text-moon-navy [--nav-link-offset:-0.05em] md:text-5xl"
								>
									{item.label}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>

		{
			hasHero ? (
				<main>
					{/* The first 24px of the page. The transparent header fades out once this leaves the screen. */}
					<div data-page-top aria-hidden="true" class="pointer-events-none absolute inset-x-0 top-0 h-6"></div>
					<slot name="hero" />
					{/* The white header fades in when this marker, 120px above the hero's bottom edge, leaves the screen. */}
					<div aria-hidden="true" class="relative">
						<div data-hero-end class="absolute inset-x-0 -top-30 h-px"></div>
					</div>
					<slot />
				</main>
			) : (
				<main class="mx-auto max-w-3xl px-6 py-16">
					<h1>{title}</h1>
					<slot />
				</main>
			)
		}

		<footer class="bg-moon-sand/45">
			<div class="mx-auto grid max-w-7xl gap-14 px-6 py-20 md:grid-cols-[1.5fr_1fr_1fr] md:px-10 md:py-24">
				<div>
					{
						/* The wide logo, rebuilt from the transparent moon and wordmark. Positions measured from public/logo-wide.png,
						with the moon at 65% of its size there, centered on the wordmark. */
					}
					<div role="img" aria-label="New Moon Birth" class="relative aspect-854/330 w-59 md:w-66.5">
						<Image src={moon} alt="" width={240} class="absolute top-0 left-0 w-[34.26%]" />
						<span class="wordmark absolute top-[40.15%] left-[14.84%] block w-[85.16%] text-moon-navy"></span>
					</div>
					<p class="mt-5 max-w-xs">Birth doula support in north Oregon and southwest Washington.</p>
				</div>
				<nav aria-labelledby="footer-explore">
					<h2 id="footer-explore" class="caps text-moon-navy">Explore</h2>
					<ul class="mt-5 space-y-2">
						{
							nav.slice(1).map((item) => (
								<li>
									<a href={item.href} class="no-underline hover:underline">
										{item.label}
									</a>
								</li>
							))
						}
					</ul>
				</nav>
				<div>
					<h2 class="caps text-moon-navy">Contact</h2>
					<ul class="mt-5 space-y-2">
						<li>Starlee Brown, birth doula</li>
						<li><a href="tel:+12819954078">281-995-4078</a></li>
						<li><a href="mailto:starlee@newmoonbirth.com">starlee@newmoonbirth.com</a></li>
						<li>Washougal, WA</li>
					</ul>
				</div>
			</div>
			<p class="caps mx-auto max-w-7xl border-t border-moon-gold/50 px-6 py-8 text-[0.65rem] md:px-10">
				© {new Date().getFullYear()} New Moon Birth
			</p>
		</footer>

		<script>
			// Fades the transparent header out once the page scrolls, and shows the floating white header once the
			// hero is scrolled away. See SiteHeader.astro.
			const overlay = document.querySelector("[data-overlay-header]");
			const pageTop = document.querySelector("[data-page-top]");
			if (overlay && pageTop) {
				overlay.toggleAttribute("data-pinned", true);
				new IntersectionObserver(([entry]) => {
					overlay.toggleAttribute("data-away", !entry.isIntersecting);
				}).observe(pageTop);
				// The faded header stays focusable. When keyboard focus lands in it, go back to the top so it fades in.
				overlay.addEventListener("focusin", () => {
					if (!overlay.hasAttribute("data-away")) return;
					const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
					scrollTo({ top: 0, behavior: reduceMotion ? "instant" : "smooth" });
				});
			}

			const floating = document.querySelector("[data-floating-header]");
			const heroEnd = document.querySelector("[data-hero-end]");
			if (floating && heroEnd) {
				new IntersectionObserver(([entry]) => {
					// Past the hero once the marker has scrolled up off the screen, not while it is still below.
					floating.toggleAttribute("data-shown", !entry.isIntersecting && entry.boundingClientRect.top < 0);
				}).observe(heroEnd);
			}
		</script>
	</body>
</html>

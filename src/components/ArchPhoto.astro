---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import StarFrame from "./StarFrame.astro";

/**
 * A photo with an arched top inside a `StarFrame`, a thin navy outline with two small stars. With a mouse, light follows the cursor over the photo, the outline leans toward it,
 * and the stars twinkle. See "Moonlight" in global.css.
 */
interface Props {
	src: ImageMetadata;
	alt: string;
	/** The photo's width on the page, as a `sizes` value. */
	sizes: string;
	/** Where the photo's crop centers, as a Tailwind `object-*` class. */
	crop?: string;
	/**
	 * Image quality, 1 to 100. Without it, Astro's defaults apply: 50 for AVIF, which smooths away fine detail
	 * such as film grain, eyelashes and hair. Set 80 where that detail matters.
	 */
	quality?: number;
	class?: string;
}

const { src, alt, sizes, crop = "object-center", quality, class: className } = Astro.props;
---

<div data-light class:list={["hover-twinkle relative p-3 md:p-4", className]}>
	<div data-light class="relative overflow-hidden rounded-t-full">
		<Picture
			src={src}
			alt={alt}
			widths={[400, 640, 960, 1280]}
			sizes={sizes}
			quality={quality}
			formats={["avif", "webp"]}
			class:list={[crop, "aspect-3/4 w-full object-cover"]}
		/>
		<span aria-hidden="true" class="moonlight"></span>
	</div>
	<StarFrame class="arch-frame rounded-t-full" />
</div>

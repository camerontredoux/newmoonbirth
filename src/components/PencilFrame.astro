---
/**
 * A hand-drawn pencil border around a photo: four strokes that bow a little and run past the corners, traced twice,
 * like the outline of `MoonPhase`. Put it after the photo, inside a `relative` box the size of the photo. It stretches
 * to that box and sits just outside its edges. It draws in as it scrolls into view, and again while a `hover-sketch`
 * parent is hovered. See "Pencil frame" in global.css.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

// In units of the box, 0 to 100 across and down. The order is the drawing order: top, right, bottom, left.
const firstPass = [
	"M-3 -2.2 Q50 -3.1 103 -1.7",
	"M102.6 -3 Q103.4 50 102.1 103",
	"M103 102.3 Q50 103.1 -3 101.8",
	"M-2.5 103 Q-3.3 50 -2.1 -3",
];
const secondPass = [
	"M-2.2 -1.5 Q50 -2.6 102.4 -2.4",
	"M101.9 -2.2 Q102.9 50 102.8 102.4",
	"M102.2 101.6 Q50 102.8 -2.4 102.5",
	"M-1.8 102.2 Q-2.8 50 -2.9 -2.4",
];
---

<svg aria-hidden="true" viewBox="0 0 100 100" preserveAspectRatio="none" class:list={["pencil-frame", className]}>
	{firstPass.map((d, i) => <path d={d} pathLength="1" style={`--stroke-step: ${i}`} />)}
	{
		secondPass.map((d, i) => (
			<path d={d} pathLength="1" class="pencil-frame-second" style={`--stroke-step: ${i + 1.5}`} />
		))
	}
</svg>

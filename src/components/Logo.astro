---
/*
 * The crescent moon beside the "NEW MOON BIRTH" wordmark. The moon is as tall as the letters.
 * Size it by the wordmark's width: pass `--wordmark-width` in `class`, for example `[--wordmark-width:10rem]`.
 */
import { Picture } from "astro:assets";
import moonMark from "../assets/moon-mark.png";

interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={["flex items-center gap-[calc(var(--wordmark-width)*0.05)]", className]}>
	{/* 18px covers the tallest wordmark (13rem wide, 17.5px tall). */}
	<Picture
		src={moonMark}
		alt=""
		height={18}
		densities={[1, 2, 3]}
		formats={["avif", "webp"]}
		loading="eager"
		class="h-[calc(var(--wordmark-width)*151/1790)] w-auto"
	/>
	<span class="wordmark block w-(--wordmark-width)"></span>
</span>

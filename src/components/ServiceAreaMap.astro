/**
 * A map of the towns Starlee serves, along the Columbia River between Portland and Vancouver. The river banks fade out
 * toward the edges, so the map sits on the page without a frame. Each town is a dot with a halo and its name.
 *
 * The banks are traced from the US Census Bureau's 2023 TIGER/Line area water (the Columbia and Willamette rivers,
 * Vancouver Lake and Camas Slough), cropped to the box below and simplified. Longitude is scaled by the cosine of the
 * middle latitude, so the map keeps true proportions: one kilometer is about 9.6 units.
 */
interface Props {
	class?: string;
}

const { class: className } = Astro.props;

const west = -122.92;
const east = -122.12;
const south = 45.4;
const north = 45.74;
const width = 600;
const kmPerLon = 111.32 * Math.cos((((south + north) / 2) * Math.PI) / 180);
const kmPerLat = 111.13;
const unitsPerKm = width / ((east - west) * kmPerLon);
const height = (north - south) * kmPerLat * unitsPerKm;

// A point's place on the map, as percentages of its width and height.
const place = (lon: number, lat: number) =>
	`left: ${(((lon - west) * kmPerLon * unitsPerKm) / width) * 100}%; top: ${(((north - lat) * kmPerLat * unitsPerKm) / height) * 100}%`;

// Where each town's name sits next to its dot.
const labelSides = {
	left: "right-4 top-0 -translate-y-1/2",
	right: "left-4 top-0 -translate-y-1/2",
	above: "bottom-3.5 left-0 -translate-x-1/2",
};

interface Town {
	name: string;
	state: string;
	lon: number;
	lat: number;
	/** The side of the dot the name sits on, chosen so no two names overlap. */
	label: keyof typeof labelSides;
}

const towns: Town[] = [
	{ name: "Portland", state: "Oregon", lon: -122.6784, lat: 45.5152, label: "left" },
	{ name: "Gresham", state: "Oregon", lon: -122.4302, lat: 45.4983, label: "right" },
	{ name: "Vancouver", state: "Washington", lon: -122.6615, lat: 45.6387, label: "right" },
	{ name: "Camas", state: "Washington", lon: -122.3995, lat: 45.5871, label: "above" },
	{ name: "Washougal", state: "Washington", lon: -122.3534, lat: 45.5826, label: "right" },
];


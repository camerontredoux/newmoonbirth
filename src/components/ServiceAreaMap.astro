---

<div class:list={["area-map relative", className]} style={`aspect-ratio: ${width} / ${height}`}>
	<svg viewBox={`0 0 ${width} ${height}`} aria-hidden="true" class="absolute inset-0 size-full">
		<defs>
			<radialGradient id="area-map-fade">
				<stop offset="0.5" stop-color="white"></stop>
				<stop offset="1" stop-color="black"></stop>
			</radialGradient>
			<mask id="area-map-edges">
				<rect width={width} height={height} fill="url(#area-map-fade)"></rect>
			</mask>
		</defs>
		<g mask="url(#area-map-edges)">
			<path d={water} fill-rule="evenodd" class="area-map-water"></path>
			<path d={water} pathLength="1" class="area-map-banks"></path>
		</g>
	</svg>
	<p aria-hidden="true" class="area-map-label caps absolute top-[16%] left-[76%] -translate-x-1/2 text-[0.625rem] tracking-[0.45em] text-moon-blue">
		Washington
	</p>
	<p aria-hidden="true" class="area-map-label caps absolute top-[86%] left-[74%] -translate-x-1/2 text-[0.625rem] tracking-[0.45em] text-moon-blue">
		Oregon
	</p>
	<p
		aria-hidden="true"
		class="area-map-label absolute top-[56%] left-[47%] -translate-1/2 rotate-[14deg] font-script text-[clamp(1.5rem,1.25rem+0.8vw,2rem)] leading-none whitespace-nowrap text-moon-blue"
	>
		Columbia River
	</p>
	<ul>
		{
			towns.map((town, i) => (
				<li style={`${place(town.lon, town.lat)}; --town-step: ${i}`} class="area-map-town absolute">
					<span class="area-map-dot"></span>
					<span
						class:list={[
							labelSides[town.label],
							"area-map-name absolute font-display text-[clamp(0.9375rem,0.875rem+0.25vw,1.125rem)] leading-none whitespace-nowrap text-moon-navy",
						]}
					>
						{town.name}
						<span class="sr-only">, {town.state}</span>
					</span>
				</li>
			))
		}
	</ul>
</div>

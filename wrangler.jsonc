{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-11-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "newmoonbirth",
	"routes": [
		{ "pattern": "newmoonbirth.com", "custom_domain": true },
		{ "pattern": "www.newmoonbirth.com", "custom_domain": true }
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "404-page"
	},
	"observability": {
		"enabled": true
	},
	// The contact form accepts a Turnstile check only from these hostnames. `.dev.vars` replaces them in `astro dev`.
	"vars": {
		"TURNSTILE_HOSTNAMES": "newmoonbirth.com,www.newmoonbirth.com"
	},
	// The contact form emails Starlee through Cloudflare Email Sending. The secret CONTACT_EMAIL_TO holds the address.
	"send_email": [{ "name": "EMAIL" }]
}